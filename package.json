{
  "name": "mf-new",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "dev:dynamic-module": "rsbuild dev --root apps/mf-main --config tests/stand/rsbuild.config.mjs",
    "test:dynamic-module": "node --test apps/mf-main/tests/stand/dynamic-module.test.mjs"
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.8.2",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.8.2",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "playwright": "1.62.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.6.2"
}
